#!/usr/bin/env python3
"""Open RommDeck on a game, from the URL RomM's plugin button opens.

RomM's plugin points its "Open in RommDeck" button at a URL like

    rommdeck://open?rom=428&platform=ngc&name=Luigi%27s%20Mansion

and this is what the desktop registers for the `rommdeck` scheme. RommDeck 1.1
and later takes the game from that URL: this hands it to the copy that is
already serving, or starts one with the URL on its command line, so either way
the UI lands on that game rather than the library's front page.

Nothing here blocks the browser: the app is started detached and the URL is
appended to a log.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
LOG = HOME / ".local" / "state" / "rommdeck-open.log"
APP = HOME / ".local" / "share" / "rommdeck" / "rommdeck"
WEB_UI = "http://127.0.0.1:8780"


def log(message: str) -> None:
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n"
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as handle:
            handle.write(line)
    except OSError:
        pass


def session_env() -> dict[str, str]:
    """The variables a GUI app needs that a URL handler may not inherit."""
    env = dict(os.environ)
    runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env.setdefault("XDG_RUNTIME_DIR", runtime)
    if not env.get("WAYLAND_DISPLAY"):
        for candidate in sorted(Path(runtime).glob("wayland-*")):
            if not candidate.name.endswith(".lock"):
                env["WAYLAND_DISPLAY"] = candidate.name
                break
    env.setdefault("DISPLAY", ":0")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    return env


def spawn(argv: list[str]) -> bool:
    try:
        subprocess.Popen(
            argv,
            env=session_env(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log(f"could not start {argv[0]}: {exc}")
        return False
    return True


def serving() -> bool:
    """Whether a copy is already answering on its web port."""
    try:
        with urllib.request.urlopen(f"{WEB_UI}/api/status", timeout=1.5) as reply:
            return reply.status == 200
    except (urllib.error.URLError, OSError):
        return False


def hand_over(rom_id: int, name: str, platform: str) -> bool:
    """Tell the running copy which game to open, over its own API."""
    body = json.dumps({"rom": rom_id, "name": name, "platform": platform}).encode()
    request = urllib.request.Request(
        f"{WEB_UI}/api/deeplink",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=2) as reply:
            return reply.status == 200
    except (urllib.error.URLError, OSError) as exc:
        log(f"could not hand the game to the running copy: {exc}")
        return False


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        log("called without a URL")
        return 2

    url = argv[1]
    query = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
    name = query.get("name", query.get("game", [""]))[0]
    platform = query.get("platform", [""])[0]
    rom = query.get("rom", ["0"])[0]
    rom_id = int(rom) if rom.isdigit() else 0
    log(f"{url} rom={rom_id or '?'} name={name or '?'}")

    if rom_id and serving():
        if hand_over(rom_id, name, platform):
            # The copy already open takes it and navigates; raising it is all
            # that is left, and the UI does that on its own next poll.
            log("handed to the running copy")
            return 0

    if APP.exists():
        # Not running (or too old to take it): the URL on the command line is
        # what the app reads to open the game at startup.
        return 0 if spawn([str(APP), url]) else 1

    if shutil.which("xdg-open"):
        return 0 if spawn(["xdg-open", WEB_UI]) else 1

    log("RommDeck not found and xdg-open is missing")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
